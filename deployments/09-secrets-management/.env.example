# ─────────────────────────────────────────────────────────────────────────────
# FintechBank – Environment Variables Reference
# Copy to .env.production and fill in real values
# NEVER commit actual secrets to git!
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
APP_VERSION=1.0.0

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-vault-in-production-minimum-64-chars
ALLOWED_ORIGINS=https://fintech.dev,https://www.fintech.dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-strong-password

# ── Registry ──────────────────────────────────────────────────────────────────
REGISTRY_HOST=registry.fintech.dev:5000
REGISTRY_USER=fintech-ci
REGISTRY_PASSWORD=changeme

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme-strong-grafana-password
PROMETHEUS_RETENTION=30d

# ── Vault (if using) ──────────────────────────────────────────────────────────
VAULT_ADDR=https://vault.fintech.dev:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SMTP_HOST=smtp.fintech.dev
SMTP_PORT=587
SMTP_USER=alerts@fintech.dev
SMTP_PASSWORD=changeme

# ── SSL / Domain ──────────────────────────────────────────────────────────────
DOMAIN=fintech.dev
CERTBOT_EMAIL=admin@fintech.dev
